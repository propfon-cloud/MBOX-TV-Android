<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mbox_bg"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/connectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <ImageView
            android:id="@+id/customLogo"
            android:layout_width="420dp"
            android:layout_height="210dp"
            android:adjustViewBounds="true"
            android:contentDescription="MBOX TV logo"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView
            android:id="@+id/defaultLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="MBOX TV"
            android:textColor="@color/mbox_text"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/connecting"
            android:textColor="@color/mbox_muted"
            android:textSize="19sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/addressBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:background="#E612151A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="8dp"
        android:paddingRight="18dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/playerUrlEdit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/field_bg"
            android:hint="http://192.168.1.117/tv/"
            android:inputType="textUri"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textColor="@color/mbox_text"
            android:textColorHint="#7F8793"
            android:textSize="18sp" />

        <Button
            android:id="@+id/openUrlButton"
            android:layout_width="150dp"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:focusable="true"
            android:text="ОТВОРИ"
            android:textSize="16sp" />

        <Button
            android:id="@+id/hideAddressBarButton"
            android:layout_width="130dp"
            android:layout_height="56dp"
            android:layout_marginLeft="10dp"
            android:focusable="true"
            android:text="СКРИЙ"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>
