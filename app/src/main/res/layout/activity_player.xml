<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mbox_bg"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/connectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <ImageView
            android:id="@+id/customLogo"
            android:layout_width="420dp"
            android:layout_height="210dp"
            android:adjustViewBounds="true"
            android:contentDescription="MBOX TV logo"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <TextView
            android:id="@+id/defaultLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="MBOX TV"
            android:textColor="@color/mbox_text"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/connecting"
            android:textColor="@color/mbox_muted"
            android:textSize="19sp" />
    </LinearLayout>
</FrameLayout>
